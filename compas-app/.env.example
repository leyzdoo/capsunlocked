# Copy to .env.local for development. In production, set these as
# Vercel project environment variables — never commit real values.

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=              # generate with: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Identity allowlist (replaces GAS's hardcoded ROLE_MAP) ---
# JSON map of Google account email -> role code, matching the original
# ROLE_MAP: { 'james.leyba@gmail.com':'JL', 'alebonola@gmail.com':'ABB' }
COMPAS_ROLE_MAP={"james.leyba@gmail.com":"JL","alebonola@gmail.com":"ABB"}

# --- Google Sheets API (service account) ---
# Share the target spreadsheet with this service account's email
# (Editor access) instead of relying on Apps Script's bound-script auth.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
COMPAS_SPREADSHEET_ID=
COMPAS_SHEET_NAME=Compas_2026_Full_Year

# --- Dev / mock mode ---
# When true, API routes serve lib/mockData.ts instead of calling the
# real Sheets API. Mirrors the original app's IS_APPS_SCRIPT offline
# fallback (see migration doc §7.8).
COMPAS_USE_MOCK_DATA=true

# --- Carried over from the GAS constants (§4.11), not yet wired up ---
# CAMILO_CAL_EMAIL=camiloleyba@gmail.com
# JAMES_NOTIFY_EMAIL=james.leyba@nyu.edu
# EMAIL_RECIPIENTS=james.leyba@gmail.com,alebonola@gmail.com
